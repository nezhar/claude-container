#!/bin/bash
#
# Claude Container Launcher
# A convenient script to run Claude Code in a Docker container
#
# Usage:
#   claude-container [options] [command]
#
# Options:
#   --workspace, -w <path>  Set workspace directory (default: current directory)
#   --config, -c <path>     Set config directory (default: $HOME/.config/claude-container)
#   --proxy                 Enable API logging proxy
#   --proxy-data <path>     Set proxy data directory (default: ./proxy-data)
#   --proxy-stop            Stop and cleanup proxy container
#   --proxy-logs            Show proxy logs
#   --help, -h              Show this help message
#
# Examples:
#   claude-container                    # Run in current directory
#   claude-container --proxy            # Run with API logging proxy
#   claude-container --proxy-stop       # Stop proxy and cleanup
#   claude-container -w /path/to/code   # Run with custom workspace
#

set -e

# Version information
# Container and proxy are always released with the same version
VERSION="1.6.12"

# Default values
WORKSPACE_DIR="$(pwd)"
CONFIG_BASE_DIR="$HOME/.config/claude-container"
CONFIG_DIR="$HOME/.config/claude-container/config"
PROXY_DATA_DIR="$HOME/.config/claude-container/proxy-data"
IMAGE="nezhar/claude-container:${VERSION}"
PROXY_IMAGE="nezhar/claude-proxy:${VERSION}"
DATASETTE_IMAGE="nezhar/claude-datasette:${VERSION}"
# Default command: just launch Claude Code. Permission prompts are disabled via
# the config dir's settings.json (permissions.defaultMode = bypassPermissions,
# written by ensure_bypass_permissions below) rather than the
# --dangerously-skip-permissions flag, because that flag's interactive acceptance
# screen regressed in recent Claude Code versions. The settings-based mode applies
# to ALL `claude` launches in the container, including explicit ones like
# `claude-container claude --resume`. The container is an isolated sandbox
# (workspace + config bind-mounts only), so the approval flow just gets in the way.
COMMAND="claude"
USE_PROXY=false
USE_DATASETTE=false
NETWORK_NAME="claude-network"
PROXY_CONTAINER_NAME="claude-proxy"
DATASETTE_CONTAINER_NAME="claude-datasette"
DATASETTE_PORT=8001
SHELL_MODE=false
TMUX_MODE=false
# Port mappings published from the workspace overlay (docker run -p args)
PORT_ARGS=()
# Extra docker run args assembled at launch time (e.g. tmux mount + env)
EXTRA_DOCKER_ARGS=()
# Skill sharing: agents inside the container propose skills into the workspace's
# .claude-container-skills/; skills adopted user-wide live in USER_SKILLS_DIR and
# are offered to every project; per-project accept/reject choices are sticky and
# live in SKILL_CHOICES_DIR (one file per workspace).
USER_SKILLS_DIR="$CONFIG_BASE_DIR/user-skills"
SKILL_CHOICES_DIR="$CONFIG_BASE_DIR/skill-choices"
# Names reserved by the image's baked-in skills (the entrypoint re-deploys these
# on every container start, so managed skills must not collide with them).
BUNDLED_SKILL_NAMES="container-overlay container-tmux container-skills"
SKILLS_ACTION=""
SKILLS_NAME=""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to display help
show_help() {
    cat << EOF
Claude Container Launcher

A convenient script to run Claude Code in a Docker container with optional API logging.

USAGE:
    claude-container [OPTIONS] [COMMAND]

OPTIONS:
    -w, --workspace <path>      Set workspace directory (default: current directory)
    -c, --config <path>         Set config directory (default: \$HOME/.config/claude-container/config)
    -h, --help                  Show this help message
    -v, --version               Show version information (Claude Container, Claude Code, Docker)
    --pull                      Pull latest images before running
    --shell                     Drop into container shell instead of starting Claude
    --tmux                      Run Claude inside a named tmux session (mounts the
                                host's ~/.tmux.conf) so you can open extra shells

PROXY OPTIONS:
    --proxy                     Enable API logging proxy
    --proxy-data <path>         Set proxy data directory (default: \$HOME/.config/claude-container/proxy-data)
    --proxy-stop                Stop and cleanup proxy container
    --proxy-logs                Show proxy container logs

DATASETTE OPTIONS:
    --datasette                 Enable Datasette for data visualization (requires --proxy)
    --datasette-only            Start only Datasette (database must already exist)
    --datasette-port <port>     Set Datasette port (default: 8001)
    --datasette-stop            Stop and cleanup Datasette container
    --datasette-logs            Show Datasette container logs

SKILLS OPTIONS:
    --skills                    List user-wide + workspace skills and this project's choices
    --skills-adopt <name>       Copy a workspace skill into the user-wide set
    --skills-accept <name>      Include a user-wide skill in this project (sticky)
    --skills-reject <name>      Exclude a user-wide skill from this project (sticky)
    --skills-reset              Forget this project's choices (prompt again next launch)
    --skills-drop <name>        Remove a skill from the user-wide set

EXAMPLES:
    claude-container                                # Run Claude (permission prompts disabled) in current dir
    claude-container --proxy                        # Run with API logging enabled
    claude-container --proxy --datasette            # Run with logging and data visualization
    claude-container --datasette-only               # Start only Datasette (if database exists)
    claude-container --proxy-stop                   # Stop the proxy container
    claude-container --datasette-stop               # Stop the Datasette container
    claude-container --proxy-logs                   # View proxy logs
    claude-container --datasette-logs               # View Datasette logs
    claude-container -w /path/to/project            # Run with custom workspace
    claude-container --pull                         # Pull latest images and run
    claude-container --shell                        # Access container shell before starting Claude
    claude-container --tmux                         # Run Claude inside a tmux session
    claude-container --skills                       # List skills and this project's choices
    claude-container --skills-adopt my-skill        # Share a workspace skill with all projects
    claude-container ls -la                         # Run custom command in container

ENVIRONMENT VARIABLES:
    CLAUDE_WORKSPACE        Override default workspace directory
    CLAUDE_CONFIG           Override default config directory
    CLAUDE_PROXY_DATA       Override default proxy data directory
    CLAUDE_IMAGE            Override default Docker image
    CLAUDE_PROXY_IMAGE      Override default proxy image
    CLAUDE_DATASETTE_IMAGE  Override default Datasette image

PROXY DATABASE:
    When using --proxy, all API requests are logged to: <proxy-data>/requests.db

    View recent requests:
        sqlite3 proxy-data/requests.db "SELECT timestamp, method, path, response_status FROM request_logs ORDER BY timestamp DESC LIMIT 10;"

DATASETTE VISUALIZATION:
    When using --datasette, a web UI is available at http://localhost:8001
    This provides an interactive interface to explore and analyze your API request logs.

FIRST TIME SETUP:
    On first run, you'll be prompted to authenticate with Claude.
    Your credentials will be stored in the config directory for future use.

WORKSPACE OVERLAY:
    A .claude-container-overlay/ directory at the workspace root layers
    project-specific state on top of the shared base image:

        .claude-container-overlay/
        ├── Dockerfile      Build fragment appended to the base image (the
        │                   overlay directory is the build context, so COPY
        │                   of files in it works). Use this to persist tools
        │                   like apt packages, Nix, or global CLIs.
        ├── overlay.json    Structured runtime config. Currently supported:
        │                   {"ports": ["8080:8080", "127.0.0.1:3000:3000"]}
        │                   Each entry is passed straight to "docker run -p".
        └── skills/<name>/  Skills proposed by Claude from inside the container
                            (deployed at launch, never baked into the image).

    The built image is tagged claude-container-overlay:<hash> over the base
    image plus the build inputs; overlay.json and skills/ are excluded from the
    hash, so port/skill changes never trigger a rebuild.

    The legacy form — a single .claude-container-overlay Dockerfile-fragment
    file with "# claude-container:port <mapping>" directive comments — is still
    supported.

BUNDLED SKILLS:
    The image ships with Claude Code skills baked in (container-overlay,
    container-tmux, container-skills). They are deployed into the skills
    directory automatically on container start, so Claude knows how to use the
    overlay, tmux, and skill-sharing features in every workspace — no
    per-project setup required.

SKILL SHARING:
    Claude can propose new skills from inside the container by writing them to
    <workspace>/.claude-container-overlay/skills/<name>/SKILL.md (the bundled
    container-skills skill teaches it how). Workspace skills are always deployed
    for their own project at launch.

    Adopt one into the user-wide set (~/.config/claude-container/user-skills)
    with --skills-adopt to offer it to every claude-container project: each
    project is prompted once at launch to accept or reject it, and the answer is
    sticky (stored under ~/.config/claude-container/skill-choices). Use --skills
    to review, and --skills-accept/--skills-reject/--skills-reset to manage a
    project's choices.

TMUX SESSION (--tmux):
    With --tmux, Claude runs inside a tmux session named "claude" and the host's
    ~/.tmux.conf is mounted in. You can open additional shells in the container
    with your tmux prefix (e.g. prefix + c) and run commands without going through
    Claude, and Claude can drive/observe windows via "tmux" and "tmux send-keys"
    against the canonical "claude" session. See the container-tmux skill.

EOF
}

# Ensure the container always runs Claude with permission prompts disabled.
#
# We do this via the config dir's settings.json (permissions.defaultMode =
# bypassPermissions) instead of the --dangerously-skip-permissions flag: the flag
# now gates behind an interactive acceptance screen that doesn't persist in recent
# Claude Code versions (so it silently falls back to per-action prompts), whereas
# the settings-based mode is honored on every launch with no prompt. The setting
# is merged into any existing settings.json, preserving other keys, and applies to
# every `claude` invocation in the container (default or explicit).
ensure_bypass_permissions() {
    local settings="$CONFIG_DIR/settings.json"
    if command -v python3 >/dev/null 2>&1; then
        SETTINGS_PATH="$settings" python3 - <<'PY' || echo -e "${YELLOW}Warning: could not update $settings (Claude may prompt for permissions).${NC}"
import json, os
path = os.environ["SETTINGS_PATH"]
data = {}
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            data = {}
    except Exception:
        # Preserve the unparseable file rather than clobbering it.
        os.replace(path, path + ".bak")
        data = {}
perms = data.setdefault("permissions", {})
if perms.get("defaultMode") != "bypassPermissions":
    perms["defaultMode"] = "bypassPermissions"
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
PY
    elif [ ! -f "$settings" ]; then
        # No python3 and no existing settings: write a minimal one.
        printf '{\n  "permissions": {\n    "defaultMode": "bypassPermissions"\n  }\n}\n' > "$settings"
    elif ! grep -q "bypassPermissions" "$settings"; then
        echo -e "${YELLOW}Warning: python3 not found; cannot merge bypassPermissions into $settings.${NC}"
        echo -e "${YELLOW}Add '\"permissions\": {\"defaultMode\": \"bypassPermissions\"}' to it to disable prompts.${NC}"
    fi
}

# --- Skill sharing ------------------------------------------------------------
#
# Skills flow through three tiers:
#
#   1. Workspace skills    <workspace>/.claude-container-overlay/skills/<name>/
#      Proposed by Claude from inside the container (see the bundled
#      container-skills skill). Always deployed for their own project.
#   2. User-wide skills    $USER_SKILLS_DIR/<name>/
#      Adopted from a workspace with --skills-adopt; offered to every project.
#   3. Per-project choices  $SKILL_CHOICES_DIR/<project-key>.conf
#      Records accept/reject per user-wide skill, per workspace. An undecided
#      skill prompts once at launch; y/n answers are sticky, skip asks again.
#
# Before each run the effective set (workspace skills + accepted user-wide
# skills) is synced into $CONFIG_DIR/skills. A manifest file records which
# entries the launcher manages, so rejected/dropped skills are cleaned up
# without touching skills the user placed there by hand or the image-bundled
# ones (the entrypoint re-deploys those on every container start).

sha256_12() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -c1-12
    else
        sha256sum | cut -c1-12
    fi
}

# Stable per-workspace identity for the choices file: readable basename + path hash.
project_key() {
    local hash
    hash=$(printf '%s' "$WORKSPACE_DIR" | sha256_12)
    printf '%s-%s\n' "$(basename "$WORKSPACE_DIR" | tr -c 'a-zA-Z0-9_.-' '-' | sed 's/-*$//')" "$hash"
}

choices_file() {
    printf '%s/%s.conf\n' "$SKILL_CHOICES_DIR" "$(project_key)"
}

valid_skill_name() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]
}

is_bundled_skill() {
    local n
    for n in $BUNDLED_SKILL_NAMES; do
        if [ "$1" = "$n" ]; then
            return 0
        fi
    done
    return 1
}

# Subdirectories of $1 that contain a SKILL.md, one name per line.
list_skill_dirs() {
    local d
    if [ ! -d "$1" ]; then
        return 0
    fi
    for d in "$1"/*/; do
        if [ -f "${d}SKILL.md" ]; then
            basename "$d"
        fi
    done
    return 0
}

# First frontmatter description line of a skill, for listings and prompts.
skill_description() {
    sed -n 's/^description:[[:space:]]*//p' "$1/SKILL.md" 2>/dev/null | head -1 | cut -c1-100
    return 0
}

get_skill_choice() {
    local file
    file="$(choices_file)"
    if [ ! -f "$file" ]; then
        return 0
    fi
    sed -n "s/^$1=//p" "$file" | tail -1
    return 0
}

set_skill_choice() {
    local name="$1" choice="$2" file tmp
    file="$(choices_file)"
    mkdir -p "$SKILL_CHOICES_DIR"
    if [ ! -f "$file" ]; then
        printf '# claude-container per-project skill choices\n# workspace: %s\n' "$WORKSPACE_DIR" > "$file"
    fi
    tmp="$file.tmp"
    grep -v "^$name=" "$file" > "$tmp" || true
    printf '%s=%s\n' "$name" "$choice" >> "$tmp"
    mv "$tmp" "$file"
}

# Ask once, per project, about each user-wide skill with no recorded choice.
# y/n answers are sticky (stored in the choices file); skip asks again next time.
prompt_undecided_skills() {
    local name choice desc answer
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        return 0
    fi
    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        choice="$(get_skill_choice "$name")"
        if [ -n "$choice" ]; then
            continue
        fi
        desc="$(skill_description "$USER_SKILLS_DIR/$name")"
        echo -e "${BLUE}New user-wide skill:${NC} ${YELLOW}${name}${NC}${desc:+ — $desc}"
        while true; do
            printf 'Include it in this project? [y]es / [n]o / [s]kip for now: '
            read -r answer < /dev/tty || answer="s"
            case "$answer" in
                y|Y|yes)
                    set_skill_choice "$name" accept
                    break
                    ;;
                n|N|no)
                    set_skill_choice "$name" reject
                    break
                    ;;
                s|S|skip|"")
                    echo -e "${BLUE}Skipped — you'll be asked again next launch.${NC}"
                    break
                    ;;
                *)
                    echo "Please answer y, n, or s."
                    ;;
            esac
        done
    done
    return 0
}

# Sync the effective skill set for this project (workspace skills + accepted
# user-wide skills) into the config dir's skills directory. Workspace skills win
# name collisions with user-wide ones; bundled names are reserved.
sync_skills() {
    local skills_dest="$CONFIG_DIR/skills"
    local manifest="$skills_dest/.claude-container-managed"
    local -a names srcs
    names=()
    srcs=()
    local name existing found old idx

    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        if ! valid_skill_name "$name"; then
            echo -e "${YELLOW}Skipping workspace skill '$name': names must be lowercase letters, digits, and hyphens.${NC}"
            continue
        fi
        if is_bundled_skill "$name"; then
            echo -e "${YELLOW}Skipping workspace skill '$name': the name is reserved by an image-bundled skill.${NC}"
            continue
        fi
        names+=("$name")
        srcs+=("$WORKSPACE_SKILLS_DIR/$name")
    done

    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        if [ "$(get_skill_choice "$name")" != "accept" ]; then
            continue
        fi
        found=false
        for existing in "${names[@]}"; do
            if [ "$existing" = "$name" ]; then
                found=true
            fi
        done
        if [ "$found" = true ]; then
            continue  # workspace copy wins the collision
        fi
        names+=("$name")
        srcs+=("$USER_SKILLS_DIR/$name")
    done

    # Nothing to manage and nothing managed before: leave the dir untouched.
    if [ ${#names[@]} -eq 0 ] && [ ! -f "$manifest" ]; then
        return 0
    fi

    mkdir -p "$skills_dest"

    # Remove previously managed skills that fell out of the set (rejected,
    # dropped user-wide, or deleted from the workspace).
    if [ -f "$manifest" ]; then
        while IFS= read -r old; do
            if [ -z "$old" ] || ! valid_skill_name "$old"; then
                continue
            fi
            found=false
            for existing in "${names[@]}"; do
                if [ "$existing" = "$old" ]; then
                    found=true
                fi
            done
            if [ "$found" = false ]; then
                rm -rf "$skills_dest/${old:?}"
            fi
        done < "$manifest"
    fi

    if [ ${#names[@]} -eq 0 ]; then
        rm -f "$manifest"
        return 0
    fi

    : > "$manifest.tmp"
    idx=0
    while [ "$idx" -lt ${#names[@]} ]; do
        rm -rf "$skills_dest/${names[$idx]:?}"
        cp -a "${srcs[$idx]}" "$skills_dest/${names[$idx]}"
        printf '%s\n' "${names[$idx]}" >> "$manifest.tmp"
        idx=$((idx + 1))
    done
    mv "$manifest.tmp" "$manifest"
    echo -e "${GREEN}Skills deployed for this project:${NC} ${YELLOW}${names[*]}${NC}"
    return 0
}

# Point out workspace skills that haven't been adopted user-wide yet.
suggest_adoptable_skills() {
    local name
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        if ! valid_skill_name "$name" || is_bundled_skill "$name"; then
            continue
        fi
        if [ -d "$USER_SKILLS_DIR/$name" ]; then
            continue
        fi
        echo -e "${BLUE}Workspace skill '${name}' can be shared with every project:${NC} claude-container --skills-adopt ${name}"
    done
    return 0
}

skills_list() {
    local name choice status desc any
    echo -e "${GREEN}User-wide skills${NC} (${USER_SKILLS_DIR}):"
    any=false
    for name in $(list_skill_dirs "$USER_SKILLS_DIR"); do
        any=true
        choice="$(get_skill_choice "$name")"
        case "$choice" in
            accept) status="${GREEN}accepted${NC}" ;;
            reject) status="${RED}rejected${NC}" ;;
            *)      status="${YELLOW}undecided — will prompt at next launch${NC}" ;;
        esac
        desc="$(skill_description "$USER_SKILLS_DIR/$name")"
        echo -e "  ${name} [${status}]${desc:+ — $desc}"
    done
    if [ "$any" = false ]; then
        echo "  (none)"
    fi
    echo ""
    echo -e "${GREEN}Workspace skills${NC} (${WORKSPACE_SKILLS_DIR}):"
    any=false
    for name in $(list_skill_dirs "$WORKSPACE_SKILLS_DIR"); do
        any=true
        if [ -d "$USER_SKILLS_DIR/$name" ]; then
            status="always active here; adopted user-wide"
        else
            status="always active here; adopt with --skills-adopt $name"
        fi
        desc="$(skill_description "$WORKSPACE_SKILLS_DIR/$name")"
        echo -e "  ${name} [${status}]${desc:+ — $desc}"
    done
    if [ "$any" = false ]; then
        echo "  (none)"
    fi
    echo ""
    echo -e "Project: ${YELLOW}${WORKSPACE_DIR}${NC}"
    echo -e "Choices: ${YELLOW}$(choices_file)${NC}"
    return 0
}

skills_adopt() {
    local name="$1" src updated
    if ! valid_skill_name "$name"; then
        echo -e "${RED}Error: invalid skill name '$name' (lowercase letters, digits, hyphens).${NC}"
        exit 1
    fi
    if is_bundled_skill "$name"; then
        echo -e "${RED}Error: '$name' is reserved by an image-bundled skill.${NC}"
        exit 1
    fi
    src="$WORKSPACE_SKILLS_DIR/$name"
    if [ ! -f "$src/SKILL.md" ]; then
        echo -e "${RED}Error: no workspace skill named '$name' (looked in $WORKSPACE_SKILLS_DIR).${NC}"
        echo -e "${YELLOW}Run 'claude-container --skills' to see what's available.${NC}"
        exit 1
    fi
    mkdir -p "$USER_SKILLS_DIR"
    updated=false
    if [ -d "$USER_SKILLS_DIR/$name" ]; then
        updated=true
    fi
    rm -rf "$USER_SKILLS_DIR/${name:?}"
    cp -a "$src" "$USER_SKILLS_DIR/$name"
    set_skill_choice "$name" accept
    if [ "$updated" = true ]; then
        echo -e "${GREEN}Updated user-wide skill '$name' from this workspace.${NC}"
    else
        echo -e "${GREEN}Adopted '$name' into the user-wide skill set.${NC}"
    fi
    echo -e "${BLUE}Accepted for this project automatically; other projects are prompted at their next launch.${NC}"
    return 0
}

skills_drop() {
    local name="$1"
    if ! valid_skill_name "$name" || [ ! -d "$USER_SKILLS_DIR/$name" ]; then
        echo -e "${RED}Error: no user-wide skill named '$name'.${NC}"
        exit 1
    fi
    rm -rf "$USER_SKILLS_DIR/${name:?}"
    echo -e "${GREEN}Removed '$name' from the user-wide skill set.${NC}"
    echo -e "${BLUE}Projects that had it deployed clean it up on their next launch.${NC}"
    return 0
}

skills_set_project_choice() {
    local name="$1" choice="$2"
    if ! valid_skill_name "$name"; then
        echo -e "${RED}Error: invalid skill name '$name'.${NC}"
        exit 1
    fi
    if [ ! -f "$USER_SKILLS_DIR/$name/SKILL.md" ]; then
        echo -e "${RED}Error: no user-wide skill named '$name'.${NC}"
        if [ -f "$WORKSPACE_SKILLS_DIR/$name/SKILL.md" ]; then
            echo -e "${YELLOW}'$name' is a workspace skill (always active in this project).${NC}"
            echo -e "${YELLOW}Adopt it user-wide first: claude-container --skills-adopt $name${NC}"
        else
            echo -e "${YELLOW}Run 'claude-container --skills' to see available skills.${NC}"
        fi
        exit 1
    fi
    set_skill_choice "$name" "$choice"
    if [ "$choice" = "accept" ]; then
        echo -e "${GREEN}Skill '$name' accepted for this project. It will be deployed on the next launch.${NC}"
    else
        echo -e "${GREEN}Skill '$name' rejected for this project. Any deployed copy is removed on the next launch.${NC}"
    fi
    return 0
}

skills_reset() {
    local file
    file="$(choices_file)"
    if [ -f "$file" ]; then
        rm -f "$file"
        echo -e "${GREEN}Cleared this project's skill choices. You'll be prompted again at the next launch.${NC}"
    else
        echo -e "${BLUE}No skill choices recorded for this project.${NC}"
    fi
    return 0
}

# Function to stop datasette
stop_datasette() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        echo -e "${YELLOW}Stopping Datasette container...${NC}"
        docker stop "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
        docker rm "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
    fi
}

# Function to stop proxy
stop_proxy() {
    if docker ps -a --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        echo -e "${YELLOW}Stopping proxy container...${NC}"
        docker stop "$PROXY_CONTAINER_NAME" 2>/dev/null || true
        docker rm "$PROXY_CONTAINER_NAME" 2>/dev/null || true
    fi

    if docker network ls --format '{{.Name}}' | grep -q "^${NETWORK_NAME}$"; then
        # Check if network has any containers
        if [ -z "$(docker network inspect "$NETWORK_NAME" -f '{{range .Containers}}{{.Name}}{{end}}' 2>/dev/null)" ]; then
            echo -e "${YELLOW}Removing network...${NC}"
            docker network rm "$NETWORK_NAME" 2>/dev/null || true
        fi
    fi
}

# Function to start proxy
start_proxy() {
    # Create network if it doesn't exist
    if ! docker network ls --format '{{.Name}}' | grep -q "^${NETWORK_NAME}$"; then
        echo -e "${GREEN}Creating Docker network...${NC}"
        docker network create "$NETWORK_NAME"
    fi

    # Check if proxy is already running
    if docker ps --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        echo -e "${BLUE}Proxy is already running${NC}"
        return 0
    fi

    # Remove stopped proxy container if exists
    if docker ps -a --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        docker rm "$PROXY_CONTAINER_NAME" 2>/dev/null || true
    fi

    # Create proxy data directory if it doesn't exist
    if [ ! -d "$PROXY_DATA_DIR" ]; then
        echo -e "${YELLOW}Creating proxy data directory: $PROXY_DATA_DIR${NC}"
        mkdir -p "$PROXY_DATA_DIR"
    fi

    # Start proxy container
    echo -e "${GREEN}Starting proxy container...${NC}"
    docker run -d \
        --name "$PROXY_CONTAINER_NAME" \
        --network "$NETWORK_NAME" \
        -v "$PROXY_DATA_DIR:/data" \
        "$PROXY_IMAGE"

    echo -e "${GREEN}Proxy started successfully${NC}"
    echo -e "Proxy logs: ${YELLOW}$PROXY_DATA_DIR/requests.db${NC}"
}

# Function to start datasette
start_datasette() {
    local standalone="${1:-false}"

    # Check if datasette is already running
    if docker ps --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        echo -e "${BLUE}Datasette is already running at http://localhost:${DATASETTE_PORT}${NC}"
        return 0
    fi

    # In standalone mode, check if database exists
    if [ "$standalone" = "true" ]; then
        if [ ! -f "$PROXY_DATA_DIR/requests.db" ]; then
            echo -e "${RED}Error: Database not found at $PROXY_DATA_DIR/requests.db${NC}"
            echo -e "${YELLOW}Run Claude Code with --proxy first to create the database${NC}"
            exit 1
        fi
        echo -e "${GREEN}Starting Datasette in standalone mode...${NC}"
    else
        # In integrated mode, ensure proxy is running
        if ! docker ps --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
            echo -e "${RED}Error: Datasette requires the proxy to be running${NC}"
            echo -e "${YELLOW}Use --proxy flag to enable the proxy${NC}"
            exit 1
        fi
    fi

    # Remove stopped datasette container if exists
    if docker ps -a --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        docker rm "$DATASETTE_CONTAINER_NAME" 2>/dev/null || true
    fi

    # Start datasette container
    # In standalone mode, no network needed; in integrated mode, use the network
    if [ "$standalone" = "true" ]; then
        echo -e "${GREEN}Starting Datasette container...${NC}"
        docker run -d \
            --name "$DATASETTE_CONTAINER_NAME" \
            -v "$PROXY_DATA_DIR:/data:ro" \
            -p "${DATASETTE_PORT}:8001" \
            "$DATASETTE_IMAGE"
    else
        echo -e "${GREEN}Starting Datasette container...${NC}"
        docker run -d \
            --name "$DATASETTE_CONTAINER_NAME" \
            --network "$NETWORK_NAME" \
            -v "$PROXY_DATA_DIR:/data:ro" \
            -p "${DATASETTE_PORT}:8001" \
            "$DATASETTE_IMAGE"
    fi

    echo -e "${GREEN}Datasette started successfully${NC}"
    echo -e "Web UI: ${YELLOW}http://localhost:${DATASETTE_PORT}${NC}"
}

# Function to cleanup on exit
cleanup() {
    local exit_code=$?
    if [ $exit_code -ne 0 ] && [ "$USE_PROXY" = true ]; then
        echo -e "\n${YELLOW}Error occurred. Cleaning up...${NC}"
        stop_proxy
    fi
}

# Parse command line arguments
STOP_PROXY=false
STOP_DATASETTE=false
SHOW_LOGS=false
SHOW_DATASETTE_LOGS=false
PULL_IMAGES=false
DATASETTE_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -w|--workspace)
            WORKSPACE_DIR="$2"
            shift 2
            ;;
        -c|--config)
            CONFIG_DIR="$2"
            shift 2
            ;;
        --proxy)
            USE_PROXY=true
            shift
            ;;
        --proxy-data)
            PROXY_DATA_DIR="$2"
            shift 2
            ;;
        --proxy-stop)
            STOP_PROXY=true
            shift
            ;;
        --proxy-logs)
            SHOW_LOGS=true
            shift
            ;;
        --datasette)
            USE_DATASETTE=true
            USE_PROXY=true  # Datasette requires proxy
            shift
            ;;
        --datasette-only)
            DATASETTE_ONLY=true
            shift
            ;;
        --datasette-port)
            DATASETTE_PORT="$2"
            shift 2
            ;;
        --datasette-stop)
            STOP_DATASETTE=true
            shift
            ;;
        --datasette-logs)
            SHOW_DATASETTE_LOGS=true
            shift
            ;;
        --skills)
            SKILLS_ACTION="list"
            shift
            ;;
        --skills-adopt|--skills-drop|--skills-accept|--skills-reject)
            if [ -z "${2:-}" ] || [[ "$2" == -* ]]; then
                echo -e "${RED}Error: $1 requires a skill name${NC}"
                exit 1
            fi
            SKILLS_ACTION="${1#--skills-}"
            SKILLS_NAME="$2"
            shift 2
            ;;
        --skills-reset)
            SKILLS_ACTION="reset"
            shift
            ;;
        --pull)
            PULL_IMAGES=true
            shift
            ;;
        --shell)
            SHELL_MODE=true
            shift
            ;;
        --tmux)
            TMUX_MODE=true
            shift
            ;;
        -v|--version)
            echo -e "${GREEN}Claude Container Version Information${NC}"
            echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo -e "Claude Container: ${YELLOW}v${VERSION}${NC}"

            # Get Claude Code version from the container
            # Try to extract version, handle both formats: "vX.Y.Z" and "X.Y.Z"
            CLAUDE_VERSION=$(docker run --rm "$IMAGE" claude --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
            if [ -z "$CLAUDE_VERSION" ]; then
                CLAUDE_VERSION="unknown"
            else
                CLAUDE_VERSION="v${CLAUDE_VERSION}"
            fi
            echo -e "Claude Code:      ${YELLOW}${CLAUDE_VERSION}${NC}"

            # Get Docker version
            DOCKER_VERSION=$(docker --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1 || echo "unknown")
            echo -e "Docker:           ${YELLOW}${DOCKER_VERSION}${NC}"
            echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            exit 0
            ;;
        *)
            # Treat remaining arguments as command to run
            COMMAND="$@"
            break
            ;;
    esac
done

# Override with environment variables if set
WORKSPACE_DIR="${CLAUDE_WORKSPACE:-$WORKSPACE_DIR}"
CONFIG_DIR="${CLAUDE_CONFIG:-$CONFIG_DIR}"
PROXY_DATA_DIR="${CLAUDE_PROXY_DATA:-$PROXY_DATA_DIR}"
IMAGE="${CLAUDE_IMAGE:-$IMAGE}"
PROXY_IMAGE="${CLAUDE_PROXY_IMAGE:-$PROXY_IMAGE}"
DATASETTE_IMAGE="${CLAUDE_DATASETTE_IMAGE:-$DATASETTE_IMAGE}"

# Handle skill management commands (host-side; no container involved).
if [ -n "$SKILLS_ACTION" ]; then
    if [ ! -d "$WORKSPACE_DIR" ]; then
        echo -e "${RED}Error: Workspace directory does not exist: $WORKSPACE_DIR${NC}"
        exit 1
    fi
    WORKSPACE_DIR="$(cd "$WORKSPACE_DIR" && pwd)"
    WORKSPACE_SKILLS_DIR="$WORKSPACE_DIR/.claude-container-overlay/skills"
    case "$SKILLS_ACTION" in
        list)   skills_list ;;
        adopt)  skills_adopt "$SKILLS_NAME" ;;
        drop)   skills_drop "$SKILLS_NAME" ;;
        accept) skills_set_project_choice "$SKILLS_NAME" accept ;;
        reject) skills_set_project_choice "$SKILLS_NAME" reject ;;
        reset)  skills_reset ;;
    esac
    exit 0
fi

# Handle shell mode - override command to drop into shell
if [ "$SHELL_MODE" = true ]; then
    COMMAND="/bin/sh"
fi

# Handle tmux mode - run the resolved command inside a named tmux session. This
# lets the user open additional shells in the container (their tmux prefix + c)
# without going through Claude, and lets Claude drive/observe extra windows via
# `tmux` / `tmux send-keys`. The session name is canonical (see the container-tmux
# skill). The host's ~/.tmux.conf is mounted in when present.
if [ "$TMUX_MODE" = true ]; then
    EXTRA_DOCKER_ARGS+=(-e "CLAUDE_TMUX_COMMAND=$COMMAND")
    if [ -f "$HOME/.tmux.conf" ]; then
        EXTRA_DOCKER_ARGS+=(-v "$HOME/.tmux.conf:/etc/claude-container/tmux.conf:ro")
    else
        echo -e "${YELLOW}No ~/.tmux.conf found on host; using tmux defaults.${NC}"
    fi
    COMMAND="claude-tmux"
fi

# Handle datasette-only command
if [ "$DATASETTE_ONLY" = true ]; then
    # Convert proxy data dir to absolute path
    PROXY_DATA_DIR="$(cd "$(dirname "$PROXY_DATA_DIR")" 2>/dev/null && pwd)/$(basename "$PROXY_DATA_DIR")" || PROXY_DATA_DIR="$(pwd)/$(basename "$PROXY_DATA_DIR")"

    if [ ! -d "$PROXY_DATA_DIR" ]; then
        echo -e "${RED}Error: Proxy data directory does not exist: $PROXY_DATA_DIR${NC}"
        echo -e "${YELLOW}Run Claude Code with --proxy first to create the database${NC}"
        exit 1
    fi

    PROXY_DATA_DIR="$(cd "$PROXY_DATA_DIR" && pwd)"
    start_datasette "true"
    exit 0
fi

# Handle datasette-stop command
if [ "$STOP_DATASETTE" = true ]; then
    stop_datasette
    echo -e "${GREEN}Datasette stopped and cleaned up${NC}"
    exit 0
fi

# Handle proxy-stop command
if [ "$STOP_PROXY" = true ]; then
    stop_datasette  # Stop datasette first if running
    stop_proxy
    echo -e "${GREEN}Proxy stopped and cleaned up${NC}"
    exit 0
fi

# Handle datasette-logs command
if [ "$SHOW_DATASETTE_LOGS" = true ]; then
    if docker ps --format '{{.Names}}' | grep -q "^${DATASETTE_CONTAINER_NAME}$"; then
        docker logs -f "$DATASETTE_CONTAINER_NAME"
    else
        echo -e "${RED}Error: Datasette container is not running${NC}"
        exit 1
    fi
    exit 0
fi

# Handle proxy-logs command
if [ "$SHOW_LOGS" = true ]; then
    if docker ps --format '{{.Names}}' | grep -q "^${PROXY_CONTAINER_NAME}$"; then
        docker logs -f "$PROXY_CONTAINER_NAME"
    else
        echo -e "${RED}Error: Proxy container is not running${NC}"
        exit 1
    fi
    exit 0
fi

# Pull images if requested
if [ "$PULL_IMAGES" = true ]; then
    echo -e "${GREEN}Pulling latest images...${NC}"
    docker pull "$IMAGE"
    if [ "$USE_PROXY" = true ]; then
        docker pull "$PROXY_IMAGE"
    fi
    if [ "$USE_DATASETTE" = true ]; then
        docker pull "$DATASETTE_IMAGE"
    fi
fi

# Validate workspace directory
if [ ! -d "$WORKSPACE_DIR" ]; then
    echo -e "${RED}Error: Workspace directory does not exist: $WORKSPACE_DIR${NC}"
    exit 1
fi

# Create config directory if it doesn't exist
if [ ! -d "$CONFIG_DIR" ]; then
    echo -e "${YELLOW}Creating config directory: $CONFIG_DIR${NC}"
    mkdir -p "$CONFIG_DIR"
fi

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
    echo -e "${RED}Error: Docker is not running or not accessible${NC}"
    echo "Please start Docker and try again."
    exit 1
fi

# Convert paths to absolute paths
WORKSPACE_DIR="$(cd "$WORKSPACE_DIR" && pwd)"
CONFIG_DIR="$(cd "$CONFIG_DIR" && pwd)" 2>/dev/null || CONFIG_DIR="$(mkdir -p "$CONFIG_DIR" && cd "$CONFIG_DIR" && pwd)"

# Always disable Claude's permission prompts for this sandboxed container.
ensure_bypass_permissions

# Per-project skill deployment: prompt for any user-wide skills this project
# hasn't decided on yet, sync the effective set (workspace + accepted user-wide)
# into the config dir's skills directory, then point out workspace skills that
# could be adopted user-wide.
WORKSPACE_SKILLS_DIR="$WORKSPACE_DIR/.claude-container-overlay/skills"
prompt_undecided_skills
sync_skills
suggest_adoptable_skills

# Overlay support: .claude-container-overlay at the workspace root layers
# project-specific state on top of the shared base image.
#
# Directory form (canonical):
#   .claude-container-overlay/
#   ├── Dockerfile      build fragment appended to the base image; the overlay
#   │                   directory is the docker build context, so COPY works
#   ├── overlay.json    structured runtime config, e.g. {"ports": ["8080:8080"]}
#   └── skills/<name>/  skills proposed from inside the container — deployed at
#                       launch by sync_skills above, never baked into the image
#
# Legacy form (still supported): a single Dockerfile-fragment file with
# `# claude-container:port <mapping>` directive comments for port mappings.
#
# The overlay image is tagged with a content hash of (base image + build inputs)
# so switching branches that have different overlays just switches images.
# Runtime-only inputs (overlay.json, skills/) are excluded from the hash, so
# changing ports or skills never triggers a rebuild.
OVERLAY_PATH="$WORKSPACE_DIR/.claude-container-overlay"
PORT_MAPPINGS=()
OVERLAY_BUILD=""
OVERLAY_CONTEXT=""
if [ -d "$OVERLAY_PATH" ]; then
    # Port mappings come from overlay.json's "ports" array; each entry is passed
    # straight to `docker run -p`.
    if [ -f "$OVERLAY_PATH/overlay.json" ]; then
        if command -v python3 >/dev/null 2>&1; then
            while IFS= read -r port_mapping; do
                if [ -n "$port_mapping" ]; then
                    PORT_ARGS+=(-p "$port_mapping")
                    PORT_MAPPINGS+=("$port_mapping")
                fi
            done < <(OVERLAY_JSON="$OVERLAY_PATH/overlay.json" python3 - <<'PY'
import json, os, sys
path = os.environ["OVERLAY_JSON"]
try:
    with open(path) as f:
        data = json.load(f)
except Exception as exc:
    print(f"Warning: could not parse {path}: {exc}", file=sys.stderr)
    sys.exit(0)
ports = data.get("ports", []) if isinstance(data, dict) else []
if isinstance(ports, str):
    ports = [ports]
for port in ports:
    if isinstance(port, str) and port.strip():
        print(port.strip())
PY
)
        else
            echo -e "${YELLOW}Warning: python3 not found; ignoring ports in overlay.json.${NC}"
        fi
    fi

    if [ -f "$OVERLAY_PATH/Dockerfile" ]; then
        OVERLAY_BUILD="$(cat "$OVERLAY_PATH/Dockerfile")"$'\n'
        OVERLAY_CONTEXT="$OVERLAY_PATH"
    fi
elif [ -f "$OVERLAY_PATH" ]; then
    echo -e "${BLUE}Note: single-file overlays still work, but .claude-container-overlay can now be${NC}"
    echo -e "${BLUE}a directory (Dockerfile + overlay.json + skills/) — see the README.${NC}"
    # Split the legacy overlay into (a) port-forwarding directives and (b) the
    # actual Dockerfile build instructions.
    #
    # Port directives are comments of the form `# claude-container:port <mapping>`
    # where <mapping> is anything docker's -p accepts (8080:8080,
    # 127.0.0.1:3000:3000, 9000:9000/udp, or a bare container port). They are a
    # RUNTIME concern (docker run -p), not a build concern, so we strip them out
    # of OVERLAY_BUILD before hashing and building. That keeps the image hash
    # stable when you only add/change/remove port mappings — no rebuild, the
    # existing overlay image is reused.
    while IFS= read -r overlay_line || [ -n "$overlay_line" ]; do
        if [[ "$overlay_line" =~ ^[[:space:]]*#[[:space:]]*claude-container:[[:space:]]*port[[:space:]]+(.+)$ ]]; then
            port_mapping="${BASH_REMATCH[1]}"
            # Trim trailing whitespace
            port_mapping="${port_mapping%"${port_mapping##*[![:space:]]}"}"
            if [ -n "$port_mapping" ]; then
                PORT_ARGS+=(-p "$port_mapping")
                PORT_MAPPINGS+=("$port_mapping")
            fi
        else
            OVERLAY_BUILD+="$overlay_line"$'\n'
        fi
    done < "$OVERLAY_PATH"
fi

if [ ${#PORT_MAPPINGS[@]} -gt 0 ]; then
    echo -e "${GREEN}Publishing overlay ports:${NC} ${YELLOW}${PORT_MAPPINGS[*]}${NC}"
fi

if [ -n "$OVERLAY_BUILD" ]; then
    # Hash base image tag + build inputs (runtime concerns excluded) -> tag. For
    # directory overlays the inputs also include any extra context files the
    # Dockerfile can COPY, keyed by relative path so renames re-hash too.
    if [ -n "$OVERLAY_CONTEXT" ]; then
        OVERLAY_HASH=$({
            printf '%s\n' "$IMAGE"
            printf '%s' "$OVERLAY_BUILD"
            (cd "$OVERLAY_CONTEXT" && find . -type f ! -name Dockerfile ! -name overlay.json ! -path './skills/*' | LC_ALL=C sort | while IFS= read -r ctx_file; do
                printf '%s\n' "$ctx_file"
                cat "$ctx_file"
            done)
        } | sha256_12)
    else
        OVERLAY_HASH=$({ printf '%s\n' "$IMAGE"; printf '%s' "$OVERLAY_BUILD"; } | sha256_12)
    fi
    OVERLAY_IMAGE="claude-container-overlay:${OVERLAY_HASH}"

    if ! docker image inspect "$OVERLAY_IMAGE" >/dev/null 2>&1; then
        # Footgun guard: if the base ($IMAGE) is itself an overlay image, the
        # overlay's build steps get re-applied on top of it. Because the parent
        # differs from the shared base, Docker's layer cache misses and expensive
        # steps (e.g. a Nix install) re-run from scratch. This usually means
        # CLAUDE_IMAGE is pinned to a previously-built overlay — unset it so the
        # overlay builds from the shared base and reuses cached layers.
        if [[ "$IMAGE" == claude-container-overlay:* ]]; then
            echo -e "${YELLOW}Warning: base image '${IMAGE}' is itself an overlay image.${NC}"
            echo -e "${YELLOW}The overlay's build steps will be re-applied on top of it, which misses${NC}"
            echo -e "${YELLOW}Docker's layer cache and may re-run expensive steps. If CLAUDE_IMAGE is${NC}"
            echo -e "${YELLOW}pinned to a built overlay, unset it (fish: 'set -e CLAUDE_IMAGE') so the${NC}"
            echo -e "${YELLOW}overlay builds from the shared base and reuses cached layers.${NC}"
        fi
        echo -e "${GREEN}Building overlay image ${OVERLAY_IMAGE} from ${IMAGE}...${NC}"
        if [ -n "$OVERLAY_CONTEXT" ]; then
            # Directory overlay: build with the overlay directory as context so
            # COPY works; the effective Dockerfile (FROM + fragment) is fed on
            # stdin so the fragment itself never needs a FROM line.
            if ! { printf 'FROM %s\n' "$IMAGE"; printf '%s' "$OVERLAY_BUILD"; } | docker build -t "$OVERLAY_IMAGE" -f - "$OVERLAY_CONTEXT"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
        else
            BUILD_DIR="$(mktemp -d)"
            trap 'rm -rf "$BUILD_DIR"' EXIT
            {
                printf 'FROM %s\n' "$IMAGE"
                printf '%s' "$OVERLAY_BUILD"
            } > "$BUILD_DIR/Dockerfile"
            if ! docker build -t "$OVERLAY_IMAGE" "$BUILD_DIR"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
            rm -rf "$BUILD_DIR"
            trap - EXIT
        fi
    fi
    IMAGE="$OVERLAY_IMAGE"
fi

# Handle proxy mode
if [ "$USE_PROXY" = true ]; then
    # Convert proxy data dir to absolute path
    PROXY_DATA_DIR="$(cd "$(dirname "$PROXY_DATA_DIR")" 2>/dev/null && pwd)/$(basename "$PROXY_DATA_DIR")" || PROXY_DATA_DIR="$(pwd)/$(basename "$PROXY_DATA_DIR")"
    mkdir -p "$PROXY_DATA_DIR"
    PROXY_DATA_DIR="$(cd "$PROXY_DATA_DIR" && pwd)"

    # Set trap for cleanup
    trap cleanup EXIT INT TERM

    # Start proxy
    start_proxy

    # Start datasette if requested
    if [ "$USE_DATASETTE" = true ]; then
        start_datasette
    fi

    echo -e "\n${GREEN}Starting Claude Container with API logging...${NC}"
    echo -e "Version:    ${YELLOW}$VERSION${NC}"
    echo -e "Workspace:  ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:     ${YELLOW}$CONFIG_DIR${NC}"
    echo -e "Proxy logs: ${YELLOW}$PROXY_DATA_DIR/requests.db${NC}"
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "Datasette:  ${YELLOW}http://localhost:${DATASETTE_PORT}${NC}"
    fi
    echo ""

    # Run the container with proxy
    docker run --rm -it \
        --network "$NETWORK_NAME" \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "ANTHROPIC_BASE_URL=http://$PROXY_CONTAINER_NAME:8080" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        "${PORT_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND

    # Note: Proxy and Datasette are intentionally left running for potential subsequent runs
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "\n${BLUE}Proxy and Datasette containers are still running.${NC}"
        echo -e "${BLUE}Datasette UI: http://localhost:${DATASETTE_PORT}${NC}"
        echo -e "${BLUE}Use '$0 --proxy-stop' to stop both containers.${NC}"
    else
        echo -e "\n${BLUE}Proxy container is still running. Use '$0 --proxy-stop' to stop it.${NC}"
    fi
else
    # Run without proxy
    echo -e "${GREEN}Starting Claude Container...${NC}"
    echo -e "Version:   ${YELLOW}$VERSION${NC}"
    echo -e "Workspace: ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:    ${YELLOW}$CONFIG_DIR${NC}"
    echo ""

    # Run the container
    docker run --rm -it \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        "${PORT_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND
fi
