        echo -e "${YELLOW}Run Claude Code with --proxy first to create the database${NC}"
        exit 1
    fi

    PROXY_DATA_DIR="$(cd "$PROXY_DATA_DIR" && pwd)"
    start_datasette "true"
    exit 0
fi

