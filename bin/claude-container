# Handle service router commands (host-side; no container involved).
if [ -n "$ROUTER_ACTION" ]; then
    ROUTER="$(router_bin)"
    if [ -z "$ROUTER" ]; then
        echo -e "${RED}Error: claude-container-router not found (expected next to this script or on PATH).${NC}"
        echo -e "${YELLOW}Re-run ./install.sh from the repo checkout to install it.${NC}"
        exit 1
    fi
    export CLAUDE_CONTAINER_CONFIG_BASE="$CONFIG_BASE_DIR"
    case "$ROUTER_ACTION" in
        start)    exec "$ROUTER" ensure ;;
        stop)     exec "$ROUTER" stop ;;
        status)   exec "$ROUTER" status ;;
        services) exec "$ROUTER" services ;;
        port)     exec "$ROUTER" port "$SERVICE_PORT_SPEC" ;;
        logs)
            if [ ! -f "$CONFIG_BASE_DIR/router.log" ]; then
                echo -e "${RED}Error: no router log at $CONFIG_BASE_DIR/router.log${NC}"
                exit 1
            fi
            exec tail -f "$CONFIG_BASE_DIR/router.log"
            ;;
    esac
fi

# Handle skill management commands (host-side; no container involved).
if [ -n "$SKILLS_ACTION" ]; then
    if [ ! -d "$WORKSPACE_DIR" ]; then
        echo -e "${RED}Error: Workspace directory does not exist: $WORKSPACE_DIR${NC}"
        exit 1
    fi
    WORKSPACE_DIR="$(cd "$WORKSPACE_DIR" && pwd)"
    WORKSPACE_SKILLS_DIR="$WORKSPACE_DIR/.claude-container-overlay/skills"
    case "$SKILLS_ACTION" in
        list)   skills_list ;;
        adopt)  skills_adopt "$SKILLS_NAME" ;;
        drop)   skills_drop "$SKILLS_NAME" ;;
        accept) skills_set_project_choice "$SKILLS_NAME" accept ;;
        reject) skills_set_project_choice "$SKILLS_NAME" reject ;;
        reset)  skills_reset ;;
    esac
    exit 0
fi

# Handle shell mode - override command to drop into shell
