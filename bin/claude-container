# Overlay support: .claude-container-overlay at the workspace root layers
# project-specific state on top of the shared base image.
#
# Directory form (canonical):
#   .claude-container-overlay/
#   ├── Dockerfile      build fragment appended to the base image; the overlay
#   │                   directory is the docker build context, so COPY works
#   ├── overlay.json    structured runtime config, e.g. {"ports": ["8080:8080"]}
#   └── skills/<name>/  skills proposed from inside the container — deployed at
#                       launch by sync_skills above, never baked into the image
#
# Legacy form (still supported): a single Dockerfile-fragment file with
# `# claude-container:port <mapping>` directive comments for port mappings.
#
# The overlay image is tagged with a content hash of (base image + build inputs)
# so switching branches that have different overlays just switches images.
# Runtime-only inputs (overlay.json, startup.sh, skills/) are excluded from the
# hash, so changing ports, runtime flags, the startup hook or skills never
# triggers a rebuild.
# Translate the allowlisted runtime keys of an overlay.json into docker run
# arguments, one per line. Kept in a function because the parser is a heredoc:
# bash 3.2 (macOS's system bash) looks for the closing paren of a process
# substitution without skipping heredoc bodies, so inlining it under <(...)
# fails to parse there.
overlay_runtime_args() {
    OVERLAY_JSON="$1" python3 - <<'PY'
import json, os, re, sys

path = os.environ["OVERLAY_JSON"]
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    # The ports pass above already reported the parse failure.
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)


def warn(msg):
    print(f"Warning: {path}: {msg}", file=sys.stderr)


def as_list(value, key):
    """Accept a bare string as a one-element list, like "ports" does."""
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        return value
    warn(f'"{key}" must be a list; ignoring it.')
    return []


out = []

for cap in as_list(data.get("capabilities", []), "capabilities"):
    if not isinstance(cap, str):
        warn(f"ignoring non-string capability {cap!r}.")
        continue
    name = cap.strip().upper()
    if name in ("ALL", "CAP_ALL"):
        warn('refusing "ALL" in "capabilities" — list the specific capabilities the project needs.')
        continue
    if not re.fullmatch(r"(CAP_)?[A-Z0-9_]+", name):
        warn(f"ignoring malformed capability {cap!r}.")
        continue
    out += ["--cap-add", name]

for dev in as_list(data.get("devices", []), "devices"):
    if not isinstance(dev, str):
        warn(f"ignoring non-string device {dev!r}.")
        continue
    spec = dev.strip()
    parts = spec.split(":")
    if len(parts) > 3:
        warn(f"ignoring malformed device {dev!r} (expected host[:container[:perms]]).")
        continue
    # Both the host and container paths must name a device node, so a device
    # entry can't be repurposed into a bind mount of an arbitrary host path.
    bad = [p for p in parts[:2] if not p.startswith("/dev/") or ".." in p.split("/")]
    if bad:
        warn(f"ignoring device {dev!r} — paths must be under /dev/ and free of '..'.")
        continue
    if len(parts) == 3 and not re.fullmatch(r"[rwm]{1,3}", parts[2]):
        warn(f"ignoring device {dev!r} — permissions must be a combination of r, w and m.")
        continue
    out += ["--device", spec]

# Docker only permits sysctls that are namespaced to the container; anything
# else would be a host-wide setting and is rejected by the daemon anyway.
SYSCTL_PREFIXES = ("net.", "fs.mqueue.", "kernel.msg", "kernel.sem", "kernel.shm")
sysctls = data.get("sysctls", {})
if not isinstance(sysctls, dict):
    warn('"sysctls" must be an object of name -> value; ignoring it.')
    sysctls = {}
for name, value in sysctls.items():
    if not isinstance(name, str) or not name.startswith(SYSCTL_PREFIXES):
        warn(f"ignoring sysctl {name!r} — only container-namespaced sysctls are allowed "
             f"({', '.join(SYSCTL_PREFIXES)}).")
        continue
    if isinstance(value, bool) or not isinstance(value, (str, int, float)):
        warn(f"ignoring sysctl {name!r} — value must be a string or number.")
        continue
    out += ["--sysctl", f"{name}={value}"]

for entry in as_list(data.get("env", []), "env"):
    if not isinstance(entry, str):
        warn(f"ignoring non-string env entry {entry!r}.")
        continue
    name, sep, _ = entry.strip().partition("=")
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
        warn(f"ignoring malformed env entry {entry!r}.")
        continue
    if sep:
        out += ["-e", entry.strip()]
    elif name in os.environ:
        out += ["-e", name]
    else:
        warn(f'"{name}" is declared in "env" but is unset in the launching environment; '
             f"the container will not see it.")

for arg in out:
    print(arg)
PY
}

OVERLAY_PATH="$WORKSPACE_DIR/.claude-container-overlay"
PORT_MAPPINGS=()
OVERLAY_BUILD=""
OVERLAY_CONTEXT=""
if [ -d "$OVERLAY_PATH" ]; then
    # Port mappings come from overlay.json's "ports" array; each entry is passed
    # straight to `docker run -p`.
    if [ -f "$OVERLAY_PATH/overlay.json" ]; then
        if command -v python3 >/dev/null 2>&1; then
            while IFS= read -r port_mapping; do
                if [ -n "$port_mapping" ]; then
                    PORT_ARGS+=(-p "$port_mapping")
                    PORT_MAPPINGS+=("$port_mapping")
                fi
            done < <(OVERLAY_JSON="$OVERLAY_PATH/overlay.json" python3 - <<'PY'
import json, os, sys
path = os.environ["OVERLAY_JSON"]
try:
    with open(path) as f:
        data = json.load(f)
except Exception as exc:
    print(f"Warning: could not parse {path}: {exc}", file=sys.stderr)
    sys.exit(0)
ports = data.get("ports", []) if isinstance(data, dict) else []
if isinstance(ports, str):
    ports = [ports]
for port in ports:
    if isinstance(port, str) and port.strip():
        print(port.strip())
PY
)
            # Runtime docker flags. Unlike "ports", these are ALLOWLISTED and
            # validated rather than forwarded verbatim: overlay.json is
            # committed with the repo and applied silently at the next launch,
            # so a cloned — or agent-written — branch must not be able to reach
            # the host with -v /:/host, --privileged or --pid=host. Each key
            # maps to exactly one docker flag:
            #
            #   "capabilities": ["NET_ADMIN"]               --cap-add NET_ADMIN
            #   "devices":      ["/dev/net/tun"]            --device /dev/net/tun
            #   "sysctls":      {"net.ipv4.ip_forward": 1}  --sysctl net.ipv4.ip_forward=1
            #   "env":          ["TS_AUTHKEY"]              -e TS_AUTHKEY
            #
            # An "env" entry with no "=" forwards the variable BY NAME, so its
            # value comes from the launching environment and never appears in
            # the container's argv (keeps secrets out of `ps`). The "NAME=value"
            # form is accepted too, for non-secret values.
            #
            # Like ports, these are runtime-only: overlay.json is excluded from
            # the image hash, so changing them never triggers a rebuild.
            while IFS= read -r runtime_arg; do
                if [ -n "$runtime_arg" ]; then
                    OVERLAY_RUNTIME_ARGS+=("$runtime_arg")
                fi
            done < <(overlay_runtime_args "$OVERLAY_PATH/overlay.json")
        else
            echo -e "${YELLOW}Warning: python3 not found; ignoring ports and runtime flags in overlay.json.${NC}"
        fi
    fi

    if [ -f "$OVERLAY_PATH/Dockerfile" ]; then
        OVERLAY_BUILD="$(cat "$OVERLAY_PATH/Dockerfile")"$'\n'
        OVERLAY_CONTEXT="$OVERLAY_PATH"
    fi
elif [ -f "$OVERLAY_PATH" ]; then
    echo -e "${BLUE}Note: single-file overlays still work, but .claude-container-overlay can now be${NC}"
    echo -e "${BLUE}a directory (Dockerfile + overlay.json + skills/) — see the README.${NC}"
    # Split the legacy overlay into (a) port-forwarding directives and (b) the
    # actual Dockerfile build instructions.
    #
    # Port directives are comments of the form `# claude-container:port <mapping>`
    # where <mapping> is anything docker's -p accepts (8080:8080,
    # 127.0.0.1:3000:3000, 9000:9000/udp, or a bare container port). They are a
    # RUNTIME concern (docker run -p), not a build concern, so we strip them out
    # of OVERLAY_BUILD before hashing and building. That keeps the image hash
    # stable when you only add/change/remove port mappings — no rebuild, the
    # existing overlay image is reused.
    while IFS= read -r overlay_line || [ -n "$overlay_line" ]; do
        if [[ "$overlay_line" =~ ^[[:space:]]*#[[:space:]]*claude-container:[[:space:]]*port[[:space:]]+(.+)$ ]]; then
            port_mapping="${BASH_REMATCH[1]}"
            # Trim trailing whitespace
            port_mapping="${port_mapping%"${port_mapping##*[![:space:]]}"}"
            if [ -n "$port_mapping" ]; then
                PORT_ARGS+=(-p "$port_mapping")
                PORT_MAPPINGS+=("$port_mapping")
            fi
        else
            OVERLAY_BUILD+="$overlay_line"$'\n'
        fi
    done < "$OVERLAY_PATH"
fi

if [ ${#PORT_MAPPINGS[@]} -gt 0 ]; then
    echo -e "${GREEN}Publishing overlay ports:${NC} ${YELLOW}${PORT_MAPPINGS[*]}${NC}"
fi

if [ ${#OVERLAY_RUNTIME_ARGS[@]} -gt 0 ]; then
    # Mask the value of a literal "-e NAME=value" so a secret written into
    # overlay.json isn't echoed to the terminal. (The by-name form, which is
    # what secrets should use, has no value to mask.)
    RUNTIME_SUMMARY=""
    prev_runtime_arg=""
    for runtime_arg in "${OVERLAY_RUNTIME_ARGS[@]}"; do
        if [ "$prev_runtime_arg" = "-e" ] && [[ "$runtime_arg" == *=* ]]; then
            runtime_arg="${runtime_arg%%=*}=***"
        fi
        RUNTIME_SUMMARY+="${RUNTIME_SUMMARY:+ }$runtime_arg"
        prev_runtime_arg="$runtime_arg"
    done
    echo -e "${GREEN}Overlay runtime flags:${NC} ${YELLOW}${RUNTIME_SUMMARY}${NC}"
fi

# Named services declared in overlay.json (display only — resolution happens
# live inside the container, so this list can grow mid-session).
SERVICES_DECLARED=""
if [ -f "$OVERLAY_PATH/overlay.json" ] && command -v python3 >/dev/null 2>&1; then
    SERVICES_DECLARED=$(OVERLAY_JSON="$OVERLAY_PATH/overlay.json" python3 - <<'PY'
import json, os
try:
    with open(os.environ["OVERLAY_JSON"]) as f:
        services = json.load(f).get("services", {})
    parts = []
    if isinstance(services, dict):
        for k, v in sorted(services.items()):
            # Bare port, or extended {"port": N, "tls": true}.
            if isinstance(v, dict):
                parts.append(f"{k}:{v.get('port')}{'(tls)' if v.get('tls') else ''}")
            else:
                parts.append(f"{k}:{v}")
    print(" ".join(parts))
except Exception:
    pass
PY
)
fi
if [ -n "$SERVICES_DECLARED" ]; then
    echo -e "${GREEN}Named services:${NC} ${YELLOW}${SERVICES_DECLARED}${NC}"
    ROUTER_HTTP_PORT="${CLAUDE_ROUTER_HTTP_PORT:-8484}"
    echo -e "${GREEN}Reachable at:${NC} ${YELLOW}http://<service>.${SERVICE_INSTANCE}.claude.localhost/${NC} (append :${ROUTER_HTTP_PORT} if port 80 isn't bound; exact URLs: claude-container --services)"
fi

if [ -n "$OVERLAY_BUILD" ]; then
    # Hash base image + build inputs (runtime concerns excluded) -> tag. For
    # directory overlays the inputs also include any extra context files the
    # Dockerfile can COPY, keyed by relative path so renames re-hash too.
    #
    # The base is keyed by its image ID (content), not just its tag: locally
    # rebuilding the base reuses the same tag, and hashing only the tag would
    # keep serving overlay images built from the stale base. Fall back to the
    # tag when the image isn't present locally yet (docker run pulls it later).
    BASE_IMAGE_KEY=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || printf '%s' "$IMAGE")
    if [ -n "$OVERLAY_CONTEXT" ]; then
        OVERLAY_HASH=$({
            printf '%s\n' "$IMAGE" "$BASE_IMAGE_KEY"
            printf '%s' "$OVERLAY_BUILD"
            (cd "$OVERLAY_CONTEXT" && find . -type f ! -name Dockerfile ! -name overlay.json ! -name startup.sh ! -path './skills/*' | LC_ALL=C sort | while IFS= read -r ctx_file; do
                printf '%s\n' "$ctx_file"
                cat "$ctx_file"
            done)
        } | sha256_12)
    else
        OVERLAY_HASH=$({ printf '%s\n' "$IMAGE" "$BASE_IMAGE_KEY"; printf '%s' "$OVERLAY_BUILD"; } | sha256_12)
    fi
    OVERLAY_IMAGE="claude-container-overlay:${OVERLAY_HASH}"

    if ! docker image inspect "$OVERLAY_IMAGE" >/dev/null 2>&1; then
        # Footgun guard: if the base ($IMAGE) is itself an overlay image, the
        # overlay's build steps get re-applied on top of it. Because the parent
        # differs from the shared base, Docker's layer cache misses and expensive
        # steps (e.g. a Nix install) re-run from scratch. This usually means
        # CLAUDE_IMAGE is pinned to a previously-built overlay — unset it so the
        # overlay builds from the shared base and reuses cached layers.
        if [[ "$IMAGE" == claude-container-overlay:* ]]; then
            echo -e "${YELLOW}Warning: base image '${IMAGE}' is itself an overlay image.${NC}"
            echo -e "${YELLOW}The overlay's build steps will be re-applied on top of it, which misses${NC}"
            echo -e "${YELLOW}Docker's layer cache and may re-run expensive steps. If CLAUDE_IMAGE is${NC}"
            echo -e "${YELLOW}pinned to a built overlay, unset it (fish: 'set -e CLAUDE_IMAGE') so the${NC}"
            echo -e "${YELLOW}overlay builds from the shared base and reuses cached layers.${NC}"
        fi
        echo -e "${GREEN}Building overlay image ${OVERLAY_IMAGE} from ${IMAGE}...${NC}"
        if [ -n "$OVERLAY_CONTEXT" ]; then
            # Directory overlay: build with the overlay directory as context so
            # COPY works; the effective Dockerfile (FROM + fragment) is fed on
            # stdin so the fragment itself never needs a FROM line.
            if ! { printf 'FROM %s\n' "$IMAGE"; printf '%s' "$OVERLAY_BUILD"; } | docker build -t "$OVERLAY_IMAGE" -f - "$OVERLAY_CONTEXT"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
        else
            BUILD_DIR="$(mktemp -d)"
            trap 'rm -rf "$BUILD_DIR"' EXIT
            {
                printf 'FROM %s\n' "$IMAGE"
                printf '%s' "$OVERLAY_BUILD"
            } > "$BUILD_DIR/Dockerfile"
            if ! docker build -t "$OVERLAY_IMAGE" "$BUILD_DIR"; then
                echo -e "${RED}Error: Failed to build overlay image${NC}"
                exit 1
            fi
            rm -rf "$BUILD_DIR"
            trap - EXIT
        fi
    fi
    IMAGE="$OVERLAY_IMAGE"
fi

# Handle proxy mode
if [ "$USE_PROXY" = true ]; then
    # Convert proxy data dir to absolute path
    PROXY_DATA_DIR="$(cd "$(dirname "$PROXY_DATA_DIR")" 2>/dev/null && pwd)/$(basename "$PROXY_DATA_DIR")" || PROXY_DATA_DIR="$(pwd)/$(basename "$PROXY_DATA_DIR")"
    mkdir -p "$PROXY_DATA_DIR"
    PROXY_DATA_DIR="$(cd "$PROXY_DATA_DIR" && pwd)"

    # Set trap for cleanup
    trap cleanup EXIT INT TERM

    # Start proxy
    start_proxy

    # Start datasette if requested
    if [ "$USE_DATASETTE" = true ]; then
        start_datasette
    fi

    echo -e "\n${GREEN}Starting Claude Container with API logging...${NC}"
    echo -e "Version:    ${YELLOW}$VERSION${NC}"
    echo -e "Workspace:  ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:     ${YELLOW}$CONFIG_DIR${NC}"
    echo -e "Proxy logs: ${YELLOW}$PROXY_DATA_DIR/requests.db${NC}"
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "Datasette:  ${YELLOW}http://localhost:${DATASETTE_PORT}${NC}"
    fi
    echo ""

    # Run the container with proxy. The svc-mux publish uses an EPHEMERAL host
    # port (empty host part) so concurrent containers never collide; the
    # background registration discovers the assigned port via `docker port`.
    register_services_async
    docker run --rm -it \
        --name "$CC_CONTAINER_NAME" \
        --network "$NETWORK_NAME" \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "ANTHROPIC_BASE_URL=http://$PROXY_CONTAINER_NAME:8080" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        -e "CLAUDE_SERVICE_INSTANCE=$SERVICE_INSTANCE" \
        -p "127.0.0.1::${MUX_CONTAINER_PORT}" \
        "${PORT_ARGS[@]}" \
        "${OVERLAY_RUNTIME_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND

    # Note: Proxy and Datasette are intentionally left running for potential subsequent runs
    if [ "$USE_DATASETTE" = true ]; then
        echo -e "\n${BLUE}Proxy and Datasette containers are still running.${NC}"
        echo -e "${BLUE}Datasette UI: http://localhost:${DATASETTE_PORT}${NC}"
        echo -e "${BLUE}Use '$0 --proxy-stop' to stop both containers.${NC}"
    else
        echo -e "\n${BLUE}Proxy container is still running. Use '$0 --proxy-stop' to stop it.${NC}"
    fi
else
    # Run without proxy
    echo -e "${GREEN}Starting Claude Container...${NC}"
    echo -e "Version:   ${YELLOW}$VERSION${NC}"
    echo -e "Workspace: ${YELLOW}$WORKSPACE_DIR${NC}"
    echo -e "Config:    ${YELLOW}$CONFIG_DIR${NC}"
    echo ""

    # Deregister the instance when the launch ends (no proxy cleanup needed).
    trap cleanup EXIT INT TERM

    # Run the container. The svc-mux publish uses an EPHEMERAL host port (empty
    # host part) so concurrent containers never collide; the background
    # registration discovers the assigned port via `docker port`.
    register_services_async
    docker run --rm -it \
        --name "$CC_CONTAINER_NAME" \
        -v "$WORKSPACE_DIR:/workspace" \
        -v "$CONFIG_DIR:/claude" \
        -e "CLAUDE_CONFIG_DIR=/claude" \
        -e "USER_UID=$(id -u)" \
        -e "USER_GID=$(id -g)" \
        -e "CLAUDE_SERVICE_INSTANCE=$SERVICE_INSTANCE" \
        -p "127.0.0.1::${MUX_CONTAINER_PORT}" \
        "${PORT_ARGS[@]}" \
        "${OVERLAY_RUNTIME_ARGS[@]}" \
        "${EXTRA_DOCKER_ARGS[@]}" \
        "$IMAGE" \
        $COMMAND
fi
